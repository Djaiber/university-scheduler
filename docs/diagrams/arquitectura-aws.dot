// Arquitectura AWS desplegada por terraform/ (módulo platform). Entorno dev: 1 NAT, RDS single-AZ.
// Regenerar:  dot -Tsvg docs/diagrams/arquitectura-aws.dot -o docs/diagrams/arquitectura-aws.svg
//             dot -Tpng -Gdpi=160 docs/diagrams/arquitectura-aws.dot -o docs/diagrams/arquitectura-aws.png
digraph aws {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=0.9,
         newrank=true, compound=true, labelloc=t, fontsize=18,
         label=<<b>university-scheduler · arquitectura AWS</b><br/><font point-size="11" color="#5b6b60">us-east-1 · Terraform (terraform/modules/platform) · flechas sólidas = petición/datos, punteadas = control/observabilidad</font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.2, margin="0.18,0.08"];
  edge  [fontname="Helvetica", fontsize=9, color="#46514a", fontcolor="#46514a", arrowsize=0.7];

  user  [label=<<b>Personal administrativo</b><br/><font point-size="9">navegador</font>>, shape=ellipse, fillcolor="#fffaf2", color="#ff8243"];
  dev   [label=<<b>Desarrollador / CI</b><br/><font point-size="9">scripts/deploy-dev.sh · GitHub Actions</font>>, shape=ellipse, fillcolor="#fffaf2", color="#ff8243"];

  subgraph cluster_edge {
    label=<<b>Borde global</b>>; style="rounded,dashed"; color="#8c8c8c"; fontsize=11;
    cf  [label=<<b>CloudFront</b><br/><font point-size="9">/* → S3 web (OAC)<br/>/v1/* → ALB</font>>, fillcolor="#efe6fb", color="#8c4fff"];
    cog [label=<<b>Cognito</b><br/><font point-size="9">Hosted UI · PKCE · sin autoregistro<br/>5 grupos de actor · MFA opcional</font>>, fillcolor="#fde7ea", color="#dd344c"];
  }

  subgraph cluster_vpc {
    label=<<b>VPC 10.40.0.0/16</b> · 2 AZ · flow logs>; style="rounded"; color="#2f6f3e"; fontcolor="#24572f"; penwidth=1.6; fontsize=12;

    subgraph cluster_public {
      label=<<b>Subredes públicas</b>>; style="rounded,filled"; fillcolor="#eef7ef"; color="#9fd6a3"; fontsize=10;
      alb [label=<<b>ALB</b><br/><font point-size="9">HTTP/HTTPS<br/>SG: solo prefijos de CloudFront</font>>, fillcolor="#efe6fb", color="#8c4fff"];
      nat [label=<<b>NAT Gateway</b><br/><font point-size="9">1 en dev</font>>, fillcolor="#efe6fb", color="#8c4fff"];
    }

    subgraph cluster_private {
      label=<<b>Subredes privadas</b>>; style="rounded,filled"; fillcolor="#f6faf6"; color="#9fd6a3"; fontsize=10;
      subgraph cluster_ecs {
        label=<<b>ECS Fargate</b> (ARM64)>; style="rounded"; color="#ed7100"; fontsize=10;
        api    [label=<<b>API</b> · NestJS<br/><font point-size="9">:3000 · 0.25 vCPU / 512 MB</font>>, fillcolor="#fff0e0", color="#ed7100"];
        worker [label=<<b>Worker</b> · Python<br/><font point-size="9">OR-Tools CP-SAT + validador<br/>0–1 tareas, escala por cola</font>>, fillcolor="#fff0e0", color="#ed7100"];
        mig    [label=<<b>Migraciones</b><br/><font point-size="9">tarea única (run-task)</font>>, fillcolor="#fff7ee", color="#ed7100", style="rounded,filled,dashed"];
      }
      rds [label=<<b>RDS PostgreSQL 16</b><br/><font point-size="9">db.t4g.micro · cifrado KMS<br/>TLS obligatorio · no público</font>>, shape=cylinder, fillcolor="#e6ecfb", color="#3b48cc"];
    }
    s3ep [label=<<b>VPC endpoint S3</b><br/><font point-size="9">gateway</font>>, fillcolor="#efe6fb", color="#8c4fff"];
  }

  subgraph cluster_regional {
    label=<<b>Servicios regionales</b>>; style="rounded,dashed"; color="#8c8c8c"; fontsize=11;
    sqs [label=<<b>SQS</b> optimization-jobs>, fillcolor="#fde7f3", color="#e7157b"];
    dlq [label=<<b>SQS DLQ</b><br/><font point-size="9">maxReceiveCount 3</font>>, fillcolor="#fde7f3", color="#e7157b"];
    s3i [label=<<b>S3 imports</b><br/><font point-size="9">CSV · retención 1 año</font>>, shape=cylinder, fillcolor="#e8f4ea", color="#3f8624"];
    s3e [label=<<b>S3 exports</b>>, shape=cylinder, fillcolor="#e8f4ea", color="#3f8624"];
    s3w [label=<<b>S3 web</b><br/><font point-size="9">panel React (estático)</font>>, shape=cylinder, fillcolor="#e8f4ea", color="#3f8624"];
    ecr [label=<<b>ECR</b><br/><font point-size="9">api · worker (inmutables)<br/>las tareas ECS descargan de aquí</font>>, fillcolor="#fff0e0", color="#ed7100"];
    sm  [label=<<b>Secrets Manager</b><br/><font point-size="9">contraseña maestra RDS<br/>rotación cada 7 días</font>>, fillcolor="#fde7ea", color="#dd344c"];
  }

  subgraph cluster_obs {
    label=<<b>Observabilidad y costes</b>>; style="rounded,dashed"; color="#8c8c8c"; fontsize=11;
    cw  [label=<<b>CloudWatch</b><br/><font point-size="9">logs de API, worker y flow logs<br/>alarmas · dashboard</font>>, fillcolor="#fde7f3", color="#e7157b"];
    sns [label=<<b>SNS</b> alertas<br/><font point-size="9">correo</font>>, fillcolor="#fde7f3", color="#e7157b"];
    bud [label=<<b>Budgets</b><br/><font point-size="9">USD 50/mes en dev</font>>, fillcolor="#f2f2f2", color="#7d8998"];
  }

  // Flujo del usuario
  user -> cf  [label="HTTPS"];
  user -> cog [label="login", style=dashed];
  cf   -> s3w [label="/*"];
  cf   -> alb [label="/v1/*"];
  alb  -> api [label=":3000"];

  // Flujo de generación de horarios
  api    -> rds;
  api    -> sqs    [label="encola solicitud"];
  api    -> s3i    [label="CSV importados"];
  sqs    -> worker [label="consume"];
  sqs    -> dlq    [label="3 intentos", style=dashed, color="#e7157b"];
  worker -> rds    [label="alternativas y validación"];
  worker -> s3e    [label="exportaciones"];
  mig    -> rds    [style=dashed];

  // Plano de control
  dev -> ecr [label="imágenes ARM64\n(CodeBuild)", style=dashed];
  dev -> s3w [label="build del panel", style=dashed];
  sm  -> api    [label="credenciales RDS\n(API y worker)", style=dotted];
  api -> cog    [label="JWKS (verifica JWT)", style=dotted];
  worker -> s3ep [label="S3 sin pasar por NAT", style=dotted, arrowhead=none];

  // Observabilidad
  dlq    -> cw [label="alarma", style=dotted, color="#e7157b"];
  cw     -> sns [style=dotted, color="#e7157b"];
  bud    -> sns [style=dotted, color="#e7157b"];

  { rank=same; user; dev; }
}
