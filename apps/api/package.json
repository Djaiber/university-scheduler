{
  "name": "@us/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS: solicitudes, estados, importaciones y gobierno de horarios",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "migrate": "bash db/migrate.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@us/shared-types": "*",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^5.5.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@us/schedule-validator": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testTimeout": 20000,
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "moduleNameMapper": {
      "^@us/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts",
      "^@us/schedule-validator$": "<rootDir>/../../packages/schedule-validator/src/index.ts"
    }
  }
}
